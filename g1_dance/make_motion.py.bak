# -*- coding: utf-8 -*-
"""手工关键帧：生成一段武术参考动作 (mjlab CSV 格式)。
每帧 = [root_x, root_y, root_z, qx, qy, qz, qw,  29关节角]
关节顺序: 左腿6 / 右腿6 / 腰3 / 左臂7 / 右臂7
  左腿: hip_pitch, hip_roll, hip_yaw, knee, ankle_pitch, ankle_roll
  腰:   yaw, roll, pitch
  左臂: shoulder_pitch, shoulder_roll, shoulder_yaw, elbow, wrist_roll, wrist_pitch, wrist_yaw
动作: 起势 → 马步抱拳 → 展臂 → 右冲拳 → 左冲拳 → 收势
用法: python make_motion.py   (在目标目录运行，输出 routine.csv)
"""
import numpy as np

# 站立(safe)基础姿态
SAFE_leg = [-0.312, 0.0, 0.0, 0.669, -0.363, 0.0]
SAFE_armL = [0.2, 0.2, 0.0, 0.6, 0.0, 0.0, 0.0]
SAFE_armR = [0.2, -0.2, 0.0, 0.6, 0.0, 0.0, 0.0]
W0 = [0.0, 0.0, 0.0]


def pose(legL, legR, waist, armL, armR):
    return np.array(legL + legR + waist + armL + armR, dtype=float)


# (时间s, 根z, 29关节)
POS = [
    (0.0, 0.76, pose(SAFE_leg, SAFE_leg, W0, SAFE_armL, SAFE_armR)),                     # 起势站立
    (2.0, 0.62, pose([-0.6, 0.25, 0, 1.0, -0.5, 0], [-0.6, -0.25, 0, 1.0, -0.5, 0], W0,
                     [0.6, 0.2, 0, 1.2, 0, 0, 0], [0.6, -0.2, 0, 1.2, 0, 0, 0])),          # 马步抱拳
    (4.0, 0.76, pose([-0.3, 0, 0, 0.5, -0.3, 0], [-0.3, 0, 0, 0.5, -0.3, 0], W0,
                     [0.0, 1.3, 0, 0.3, 0, 0, 0], [0.0, -1.3, 0, 0.3, 0, 0, 0])),         # 展臂(双臂侧举)
    (6.0, 0.76, pose([-0.3, 0, 0, 0.5, -0.3, 0], [-0.35, 0, 0, 0.6, -0.3, 0], W0,
                     [0.5, 0.3, 0, 1.3, 0, 0, 0], [1.4, 0.0, 0, 0.1, 0, 0, 0])),          # 右冲拳(右臂前伸,左抱架)
    (8.0, 0.76, pose([-0.35, 0, 0, 0.6, -0.3, 0], [-0.3, 0, 0, 0.5, -0.3, 0], W0,
                     [1.4, 0.0, 0, 0.1, 0, 0, 0], [0.5, -0.3, 0, 1.3, 0, 0, 0])),         # 左冲拳
    (10.0, 0.76, pose(SAFE_leg, SAFE_leg, W0, SAFE_armL, SAFE_armR)),                    # 收势站立
]

FPS = 30
DUR = POS[-1][0]


def ease(t):
    return 0.5 - 0.5 * np.cos(np.pi * np.clip(t, 0.0, 1.0))


def interp(tf):
    for i in range(len(POS) - 1):
        t0, z0, p0 = POS[i]
        t1, z1, p1 = POS[i + 1]
        if t0 <= tf <= t1:
            a = ease((tf - t0) / max(t1 - t0, 1e-9))
            return z0 + (z1 - z0) * a, p0 + (p1 - p0) * a
    return POS[-1][1], POS[-1][2]


def main():
    rows = []
    for fi in range(int(DUR * FPS) + 1):
        tf = fi / FPS
        z, p = interp(tf)
        # 根: x=0,y=0,z=高度; 朝向 identity (qx,qy,qz,qw = 0,0,0,1)
        rows.append([0.0, 0.0, z, 0.0, 0.0, 0.0, 1.0] + list(p))
    arr = np.array(rows)
    np.savetxt("routine.csv", arr, delimiter=",", fmt="%.5f")
    print("wrote routine.csv  frames=%d  duration=%.1fs" % (len(rows), DUR))


if __name__ == "__main__":
    main()
